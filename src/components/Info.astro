---
interface Props {
  title: string
  descriptions: string[]
  href?: string
}

const { props } = Astro
---

<div class='space-y-2'>
  <h3>
    <a
      href={props.href}
      class='hover:text-primary transition-all ease-in-out'
      target='_blank'>{props.title}</a
    >
  </h3>
  <div class='space-y-0.5'>
    {
      props.descriptions.map((description) => {
        return <p class='italic text-sm'>{description}</p>
      })
    }
  </div>
</div>
