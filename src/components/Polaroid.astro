---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { cn } from '../lib/cn'

interface Props {
  image: ImageMetadata
  caption: string
  class?: string
}

const { image, caption, class: className } = Astro.props
---

<figure
  class={cn(
    'flex w-48 flex-col bg-white px-3 pt-2.5 pb-3 inset-shadow-polaroid',
    className,
  )}
>
  <Image
    src={image}
    alt={caption}
    width={336}
    class='h-48 w-full object-cover'
  />
  <figcaption class='mt-2 font-hand text-sm text-text-muted'>
    {caption}
  </figcaption>
</figure>
