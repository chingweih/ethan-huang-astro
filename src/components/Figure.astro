---
import type { ImageMetadata } from 'astro'
import { getImage, Image } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
}

const { src, alt } = Astro.props

const full = await getImage({ src, width: Math.min(src.width, 2400) })

// MDX wraps images in <p>, so this uses spans instead of <figure> to stay valid HTML
---

<span
  class='not-prose relative left-1/2 flex w-breakout -translate-x-1/2 flex-col items-center gap-4 py-5'
>
  <Image
    src={src}
    alt={alt}
    widths={[928, 1856]}
    sizes='(min-width: 968px) 928px, calc(100vw - 40px)'
    data-pswp-src={full.src}
    data-pswp-width={full.attributes.width}
    data-pswp-height={full.attributes.height}
    class='w-full cursor-zoom-in rounded-md'
  />
  {alt && <span class='text-text-muted'>{alt}</span>}
</span>
