---
import Name from '../components/Name.svelte'
import Polaroid from '../components/Polaroid.astro'
import { snapshots } from '../../collections/snapshots'
import Page from '../layouts/Page.astro'

const [latest, previous] = snapshots
---

<Page>
  <div
    class='flex flex-1 flex-col items-center justify-center gap-10 md:flex-row md:justify-between'
  >
    <div class='flex max-w-lg flex-col gap-10'>
      <p class='text-2xl text-balance'>
        Hi, I’m <Name client:visible />. Data engineer, occasional journalist,
        making cool maps and moving charts <a
          href='https://www.twreporter.org'
          class='font-medium'>@twreporter</a
        >.
      </p>
      <p class='text-lg text-text-muted'>
        <span class='font-medium'>Political science</span> taught me that every dataset
        is somebody’s decision.
      </p>
      <p class='text-lg [&_a]:underline'>
        Welcome to my corner of the web. You can find <a href='/projects'
          >things I helped create</a
        >, <a href='/notes'>my messy writings</a> or <a href='/snapshots'
          >snapshots of my life</a
        > here.
      </p>
    </div>
    <a
      href='/snapshots'
      class='flex flex-col items-center gap-2.5 self-stretch px-2.5 md:self-auto'
    >
      <div class='relative h-96 w-104 max-w-full max-xs:scale-85'>
        <Polaroid
          image={previous.image}
          caption={previous.caption}
          class='absolute top-1/2 left-1/2 -mt-2.5 -ml-9 -translate-1/2 -rotate-7'
        />
        <Polaroid
          image={latest.image}
          caption={latest.caption}
          class='absolute top-1/2 left-1/2 mt-5.5 ml-13 -translate-1/2'
        />
      </div>
      <p class='text-sm text-text-muted'>recent snapshots</p>
    </a>
  </div>
</Page>
