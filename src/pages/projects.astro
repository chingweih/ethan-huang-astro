---
import { getImage, Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Laurel from '../assets/laurel.svg'
import AutoScroll from '../components/AutoScroll.svelte'
import MoreLinks from '../components/MoreLinks.svelte'
import ProjectLink from '../components/ProjectLink.astro'
import Page from '../layouts/Page.astro'

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async ({ data }) => ({
      ...data,
      images: await Promise.all(
        data.images.map(async (image) => ({
          image,
          full: await getImage({
            src: image,
            width: Math.min(image.width, 2400),
          }),
        })),
      ),
    })),
)
---

<Page title='things I helped create'>
  <h1 class='border-b border-border pb-2 font-pixel text-lg'>
    behind the stories, things i helped create.
  </h1>
  <div class='flex flex-col gap-7 py-8'>
    {
      projects.map((project) => (
        <article class='flex flex-col gap-x-11 gap-y-5 py-2.5 md:flex-row md:items-center'>
          <div class='flex flex-col justify-between gap-5 self-stretch py-4 md:w-1/2'>
            <div class='flex flex-col gap-2.5'>
              {project.award && (
                <p class='flex items-center gap-0.75 text-xs text-text-muted'>
                  <Laurel aria-hidden='true' />
                  {project.award}
                  <Laurel aria-hidden='true' class='-scale-x-100' />
                </p>
              )}
              <h2 class='text-lg'>{project.title}</h2>
              {project.description && (
                <p class='text-sm'>{project.description}</p>
              )}
            </div>
            <div class='flex flex-col gap-2.5 text-xs text-text-muted'>
              {project.links.slice(0, 2).map((link) => (
                <ProjectLink {...link} />
              ))}
              {project.links.length > 2 && (
                <MoreLinks client:visible>
                  {project.links.slice(2).map((link) => (
                    <ProjectLink {...link} />
                  ))}
                </MoreLinks>
              )}
            </div>
          </div>
          <div class='min-w-0 flex-1'>
            <AutoScroll client:visible>
              {project.images.map(({ image, full }) => (
                <Image
                  src={image}
                  alt=''
                  height={384}
                  draggable='false'
                  data-pswp-src={full.src}
                  data-pswp-width={full.attributes.width}
                  data-pswp-height={full.attributes.height}
                  class='h-48 w-auto shrink-0 cursor-zoom-in rounded-sm border border-border'
                />
              ))}
            </AutoScroll>
          </div>
        </article>
      ))
    }
  </div>
</Page>
