---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '@fontsource-variable/noto-sans-tc'
import '@fontsource-variable/pixelify-sans'
import '@fontsource-variable/roboto-slab'
import '@fontsource/reenie-beanie'
import { cn } from '../lib/cn'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  class?: string
}

const DEFAULTS = {
  title: 'Ethan Huang 黃靖緯',
  description:
    'Data engineer, occasional journalist, making cool maps and moving charts.',
}

const TEMPLATE = {
  title: '｜Ethan Huang',
}

const {
  title: titleProps,
  description: descriptionProps,
  class: className,
} = Astro.props

const props = {
  title: titleProps ? `${titleProps}${TEMPLATE.title}` : DEFAULTS.title,
  description: descriptionProps ?? DEFAULTS.description,
  image: new URL(
    `/og${Astro.url.pathname.replace(/\/$/, '') || '/index'}.png`,
    Astro.site,
  ),
}

const metadata = {
  twitterHandle: '@chingweih',
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <link rel='icon' href='/favicon.png' />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={props.description} />
    <meta property='og:title' content={props.title} />
    <meta property='og:description' content={props.description} />
    <meta property='og:image' content={props.image} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={props.title} />
    <meta name='twitter:description' content={props.description} />
    <meta name='twitter:site' content={metadata.twitterHandle} />
    <title>{props.title}</title>
  </head>
  <body class={cn('bg-bg font-sans text-text', className)}>
    <slot />
  </body>
</html>
